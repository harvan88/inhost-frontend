{
   "name": "inhost-frontend",
   "version": "1.0.0",
   "type": "module",
   "private": true,
   "scripts": {
      "dev": "vite",
      "build": "tsc && vite build",
      "preview": "vite preview",
      "type-check": "tsc --noEmit",
      "deadcode:exports": "ts-prune",
      "deadcode:files": "unimported",
      "deadcode:deps": "depcheck",
      "deadcode:all": "npm run deadcode:exports && npm run deadcode:files"
   },
   "dependencies": {
      "@tanstack/react-query": "^5.90.10",
      "@tanstack/react-virtual": "^3.13.12",
      "axios": "^1.13.2",
      "idb": "^8.0.3",
      "lucide-react": "^0.554.0",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "react-router-dom": "^7.9.6",
      "zustand": "^5.0.8"
   },
   "devDependencies": {
      "@types/react": "^18.2.43",
      "@types/react-dom": "^18.2.17",
      "@types/react-router-dom": "^5.3.3",
      "@vitejs/plugin-react": "^4.2.1",
      "autoprefixer": "^10.4.16",
      "depcheck": "^1.4.7",
      "postcss": "^8.4.32",
      "tailwindcss": "^3.3.6",
      "ts-prune": "^0.10.3",
      "typescript": "^5.3.3",
      "unimported": "^1.31.0",
      "vite": "^5.0.8"
   }
}
